NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-secret-key
RESEND_API_KEY=replace-with-resend-api-key
RECRUTA_EMAIL_FROM=Recruta <notifications@example.com>
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional company autocomplete. Search requests go directly from the browser.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
BRANDFETCH_API_KEY=
# Enable only after confirming your Brand API plan permits storing reviewed data/logos.
BRANDFETCH_PERSISTENCE_ALLOWED=false

# Optional AI screening. Disabled until explicitly enabled and privacy reviewed.
# Local/staging must use synthetic applications only. Never use NEXT_PUBLIC keys.
OPENAI_API_KEY=
# Choose and evaluate a file-input + Structured Outputs model; no silent default.
OPENAI_SCREENING_MODEL=
RECRUTA_AI_ENABLED=false
RECRUTA_AI_DATA_USE_APPROVED=false
# At least 32 random characters. Used only by the private screening worker route.
SCREENING_WORKER_SECRET=

# Candidate email and intake automation are explicit opt-ins. Configure a worker
# scheduler and verified Resend domain before enabling. Never send real staging data.
RECRUTA_CANDIDATE_EMAIL_ENABLED=false
RECRUTA_AUTOMATIONS_ENABLED=false
AUTOMATION_WORKER_SECRET=
RESEND_WEBHOOK_SECRET=
