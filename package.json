{
  "name": "recruta-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "node --test scripts/process-applicants.test.mjs",
    "test:screening:live": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run src/server/screening/screening.live.test.ts",
    "db:start": "supabase start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public",
    "test:e2e": "npm run build && start-server-and-test start http://127.0.0.1:3000 test:e2e:run",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "5.2.2",
    "@sentry/nextjs": "11.8.0",
    "@solar-icons/react": "2.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "geist": "1.8.2",
    "next": "16.4.2",
    "openai": "7.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "27.0.1",
    "prettier": "3.6.2",
    "start-server-and-test": "3.0.13",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
